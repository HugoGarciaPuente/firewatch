# FireWatch Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# --- NASA FIRMS ---
NASA_FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
# YYYY-MM-DD; empty = today
NASA_FIRMS_DATE=
# Secret: get one at https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_API_KEY=
# FIRMS product. NRT only keeps ~4 months and SP (standard product) lags
# ~4 months behind: June 2026 needs VIIRS_SNPP_SP, July onwards VIIRS_SNPP_NRT.
# Check /api/data_availability/csv/{key}/all before backfilling a new period.
NASA_FIRMS_SOURCE=VIIRS_SNPP_NRT

# --- Regions tracked (comma-separated) ---
# Defined in config.Settings.REGION_BBOXES:
#   peninsula      mainland (37.0N-43.9N)
#   peninsula_sur  southern Andalusia (35.9N-37.1N, west of -1.8E)
#   canarias
#   baleares
# `peninsula` implicitly pulls in `peninsula_sur` (see resolve_regions), so
# listing only `peninsula` still covers the whole mainland.
FIREWATCH_REGIONS=peninsula,peninsula_sur,canarias,baleares
# Countries kept after reverse geocoding (ISO-3166 alpha-2, comma-separated).
# The bboxes are rectangles and also catch Portugal and southern France; this
# list is what actually decides. Points without a resolved country are kept.
FIREWATCH_COUNTRY_CODES=es

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INGEST_TOPIC=firms-ingest

# --- PostgreSQL ---
POSTGRES_DSN=postgresql://firewatch:firewatch@localhost:5432/firewatch
# Also read by docker-compose; required (the compose file refuses to start
# without it). Use a strong value in production.
POSTGRES_DB=firewatch
POSTGRES_USER=firewatch
POSTGRES_PASSWORD=

# --- Weather (Open-Meteo) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# The forecast endpoint only keeps ~30 days. Older dates need the ERA5 archive,
# which exposes the same hourly series; without it, summer backfills get 400 or
# empty series and every point is scored on brightness alone.
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_DAYS=30
ENABLE_WEATHER_ENRICHMENT=true
# Cache cell size in degrees (~0.25 deg = 25 km). Weather does not vary
# appreciably at this scale, and it keeps Open-Meteo requests proportional
# to distinct cells instead of to record count.
WEATHER_CACHE_CELL=0.25

# --- Reverse geocoding (Nominatim / OpenStreetMap) ---
# FIRMS returns coordinates only, so locality is resolved separately.
# Set ENABLE_GEOCODING=false to stop resolving (the processor then skips the
# lookup and points are filled later with `runner geocode-backfill`).
ENABLE_GEOCODING=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# The OSMF usage policy REQUIRES an identifying User-Agent and caps use at
# 1 request/second. Lowering GEOCODE_MIN_INTERVAL gets you HTTP 429.
NOMINATIM_USER_AGENT=FireWatch/0.2 (university practice project)
GEOCODE_MIN_INTERVAL=1.1

# --- App / Auth ---
APP_NAME=firewatch
APP_VERSION=0.2.0
# development | production. In production the app refuses to start without
# valid API_KEY and SESSION_SECRET, and disables /docs, /redoc, /openapi.json.
APP_ENV=development

# Shared operator key. Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be >= 16 characters. Never reuse this value anywhere else.
API_KEY=
# Signs browser session cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be different from API_KEY: sharing one value means whoever holds the key
# can also forge sessions.
SESSION_SECRET=
# Session lifetime in seconds (default 12h).
SESSION_MAX_AGE=43200
# Set true when serving over HTTPS. Leave false for local http development.
SESSION_COOKIE_SECURE=false
